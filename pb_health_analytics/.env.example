# Copy to .env (same folder) and fill in. .env is git-ignored - never commit credentials.
PB_PORTAL_USERNAME=
PB_PORTAL_PASSWORD=

# Optional overrides
# PB_DB_PATH=data/pb_health.db
# PB_SEARCH_CHUNK_DAYS=2        # 1-3 days per search window (avoid 504s)
# PB_RATE_LIMIT_SECS=0.5        # min seconds between API calls
# PB_TRANSCRIPT_WORKERS=4       # parallel transcript fetches
# PB_REQUEST_TIMEOUT=90
