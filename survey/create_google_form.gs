/**
 * PB Health Employee Awareness Survey: Google Form builder.
 *
 * How to use:
 * 1. Open https://script.google.com and click "New project".
 * 2. Delete the sample code, paste this whole file, and click Save.
 * 3. Pick "createSurvey" in the function list at the top and click Run.
 *    Allow access when Google asks (first run only).
 * 4. The form and its response sheet are created in your Google Drive.
 *    The links are printed in the Execution log at the bottom.
 */

const HELPLINE = '1800 1201';
const AMBULANCE = '1800 1203';

function createSurvey() {
  const form = FormApp.create('PB Health Employee Awareness Survey');
  form
    .setDescription('PB Health Hospital, IFFCO Chowk, Gurugram. Takes 2 minutes.')
    .setProgressBar(true)
    .setShowLinkToRespondAgain(true)
    .setAllowResponseEdits(false)
    .setCollectEmail(false)
    .setLimitOneResponsePerUser(false)
    .setConfirmationMessage(
      'Thank you!\n\nSave these numbers:\nHelpline ' + HELPLINE + '\nAmbulance ' + AMBULANCE);
  try { form.setRequireLogin(false); } catch (e) { /* only available on Workspace accounts */ }

  // ---------- Page 1: About you
  const logo = Utilities.newBlob(Utilities.base64Decode(LOGO_PNG_BASE64), 'image/png', 'pbhealth-logo.png');
  form.addImageItem().setImage(logo).setAlignment(FormApp.Alignment.CENTER).setWidth(300);

  form.addSectionHeaderItem().setTitle('About you');
  form.addTextItem().setTitle('Name').setRequired(true);
  form.addTextItem().setTitle('Department').setRequired(true);
  form.addTextItem().setTitle('Floor');
  form.addMultipleChoiceItem()
    .setTitle('Lives in')
    .setChoiceValues(['Gurugram', 'Delhi', 'Noida'])
    .showOtherOption(true)
    .setRequired(true);
  const knows = form.addMultipleChoiceItem()
    .setTitle('Do you know PB Health has its own hospital in Gurugram?')
    .setRequired(true);

  // ---------- Page 2: How they heard (only if Yes)
  const pageHeard = form.addPageBreakItem().setTitle('About you');
  form.addMultipleChoiceItem()
    .setTitle('How did you hear about it?')
    .setChoiceValues(['Colleague', 'Office email / Slack', 'Office standee', 'Social media'])
    .showOtherOption(true)
    .setRequired(true);

  // ---------- Page 3: Current hospital + Know your hospital
  const pageQuiz = form.addPageBreakItem().setTitle('Your hospital');
  form.addMultipleChoiceItem()
    .setTitle('Which hospital does your family usually go to?')
    .setChoiceValues(['Medanta', 'Fortis', 'Artemis', 'Max', 'None'])
    .showOtherOption(true)
    .setRequired(true);

  form.addSectionHeaderItem().setTitle('Know your hospital');
  mc(form, 'Where is PB Health Hospital?',
    ['IFFCO Chowk', 'Golf Course Road', 'Sohna Road', 'Dwarka Expressway']);
  mc(form, 'What can you get at PB Health?',
    ['Doctor visits', 'Lab tests', 'X-ray, CT, MRI', '24x7 Emergency', 'Surgery & ICU', 'All of the above']);
  mc(form, 'Which doctors are available?',
    ['Cardiology', 'Orthopaedics', 'Neurology / Neurosurgery', 'Gastroenterology', 'Paediatrics',
     'Gynaecology', 'ENT', 'Urology', 'All of the above']);
  mc(form, 'How much discount do you get on doctor consultation?',
    ['No discount', '25%', '50%', '75%']);
  mc(form, 'How much discount do you get on X-ray, CT and MRI?',
    ['No discount', '10%', '20%', '30%']);
  mc(form, 'What do you get free?',
    ['Registration', 'Follow-up within 10 days', 'Ambulance within 10 km', 'All of the above']);
  mc(form, 'Who can use these benefits?',
    ['Only me', 'Me, spouse, kids', 'Me, spouse, kids, parents', 'Me, spouse, kids, parents, in-laws']);
  mc(form, 'Do you know the PB Health helpline number?', ['Yes, ' + HELPLINE, 'No']);
  mc(form, 'Do you know the PB Health ambulance number?', ['Yes, ' + AMBULANCE, 'No']);

  // ---------- Page 4: Visit intent
  form.addPageBreakItem().setTitle('Last question');
  const visit = form.addMultipleChoiceItem()
    .setTitle('Will you visit PB Health next time you need a doctor?')
    .setRequired(true);

  // ---------- Page 5: Reason (only if No)
  const pageWhy = form.addPageBreakItem().setTitle('Tell us why');
  form.addParagraphTextItem()
    .setTitle('Why not? What would make you visit PB Health?')
    .setRequired(true);

  // ---------- Page 6: Benefits, numbers, call back, surveyor
  const pageEnd = form.addPageBreakItem()
    .setTitle('Your PB Health benefits')
    .setHelpText([
      'For you, spouse, kids, parents and in-laws',
      '',
      '75% off doctor consultation',
      '30% off X-ray, CT, MRI',
      'Free registration',
      'Free follow-up within 10 days',
      'Free ambulance within 10 km',
      '',
      'PB Health Hospital, IFFCO Chowk, Gurugram',
      'Helpline ' + HELPLINE + '  |  Ambulance ' + AMBULANCE,
    ].join('\n'));
  form.addMultipleChoiceItem()
    .setTitle('Saved the helpline and ambulance numbers on phone?')
    .setChoiceValues(['Yes', 'No'])
    .setRequired(true);
  form.addTextItem()
    .setTitle('Want a call to book a doctor? Mobile number')
    .setHelpText('Leave blank if not needed')
    .setValidation(FormApp.createTextValidation()
      .setHelpText('Enter a 10 digit mobile number')
      .requireTextMatchesPattern('^[6-9][0-9]{9}$')
      .build());
  form.addSectionHeaderItem().setTitle('For surveyor');
  form.addTextItem().setTitle('Surveyor name').setRequired(true);
  form.addTextItem().setTitle('Location / office');

  // ---------- Skip logic
  knows.setChoices([knows.createChoice('Yes', pageHeard), knows.createChoice('No', pageQuiz)]);
  visit.setChoices([
    visit.createChoice('Yes', pageEnd),
    visit.createChoice('Maybe', pageEnd),
    visit.createChoice('No', pageWhy),
  ]);

  // ---------- Responses go to a Google Sheet
  const sheet = SpreadsheetApp.create('PB Health Employee Awareness Survey (Responses)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  try { form.setPublished(true); } catch (e) { /* older Forms without a publish step */ }
  form.setAcceptingResponses(true);

  Logger.log('Form link to share: ' + form.getPublishedUrl());
  Logger.log('Edit the form:      ' + form.getEditUrl());
  Logger.log('Responses sheet:    ' + sheet.getUrl());
}

function mc(form, title, choices) {
  return form.addMultipleChoiceItem().setTitle(title).setChoiceValues(choices).setRequired(true);
}

// PB Health logo (PNG), shown at the top of the form.
const LOGO_PNG_BASE64 = '';
